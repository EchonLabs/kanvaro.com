# Kanvaro MCP server — configuration (task 1.2)
# Copy to .env for local development: `cp .env.example .env`. Never commit .env.
#
# SECRETS (marked [secret]) come from the secret store in production:
#   set <NAME>_FILE to the path of a file that holds the value
#   (Docker / Kubernetes secrets, Vault Agent). A plain <NAME>=value is refused when
#   NODE_ENV=production and allowed only for local development.
# Keep comments on their own lines: text after a value becomes part of the value.

NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info

# Public origin of this server (OAuth issuer). https in production; no path, no trailing slash.
PUBLIC_BASE_URL=http://localhost:3100
# Browser origins allowed to call /mcp (comma-separated). Claude Code sends no Origin; leave empty.
ALLOWED_ORIGINS=

# Kanvaro: address this server uses for API calls (may be internal http)
KANVARO_API_BASE_URL=http://localhost:3000
# Kanvaro: address users' browsers use to sign in (https in production)
KANVARO_PUBLIC_URL=http://localhost:3000
KANVARO_CLIENT_ID=kanvaro-mcp-server
# [secret] production: KANVARO_CLIENT_SECRET_FILE=/run/secrets/kanvaro_client_secret
KANVARO_CLIENT_SECRET=change-me
KANVARO_REQUEST_TIMEOUT_MS=10000

# Database (separate from Kanvaro's)
# [secret] production: MONGODB_URI_FILE=/run/secrets/mongodb_uri
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=kanvaro_mcp

# [secret] Encryption keys for users' stored Kanvaro tokens.
# Format: id:base64key[,id2:base64key2] — each key 32 random bytes. The first key (or
# TOKEN_ENCRYPTION_ACTIVE_KEY_ID) encrypts new values; older keys stay listed for reading.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# production: TOKEN_ENCRYPTION_KEYS_FILE=/run/secrets/token_encryption_keys
TOKEN_ENCRYPTION_KEYS=dev1:REPLACE_WITH_32_BYTE_BASE64_KEY
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=

# Token lifetimes in seconds.
# Access: 5–60 min (Claude Code refreshes before every call if tokens are very short-lived).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh: at most 7 days (Kanvaro's refresh token lifetime).
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_CODE_TTL_SECONDS=60

# Audit log retention in days
AUDIT_RETENTION_DAYS=180
