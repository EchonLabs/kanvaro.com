# Environment Configuration for Kanvaro
# Copy this file to .env and update the values for your deployment

# ===========================================
# Database Configuration
# ===========================================
# Database credentials are configured through the setup wizard UI
# No database credentials needed in environment variables

# ===========================================
# Authentication Secrets
# ===========================================
# Generate secure random strings for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ===========================================
# Redis Configuration
# ===========================================
# For Docker deployment, use internal service name
REDIS_URL=redis://redis:6379

# ===========================================
# AI Standup Dashboard — Groq Configuration
# ===========================================
# Get your key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
# Model to use for standup analysis (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
# Hour (0-23) when the EOD analysis job fires each day (default: 8 = 8 AM)
STANDUP_ANALYSIS_HOUR=8
# Hour (0-23) when the working circle starts (default: 9 = 9 AM standup)
STANDUP_WORKING_CIRCLE_START_HOUR=9

# ===========================================
# Public (client-exposed) Configuration
# ===========================================
# Exposed to the browser; safe for non-secrets
NEXT_PUBLIC_APP_VERSION=0.0.1
# Optionally set by CI to display commit SHA when version not provided
NEXT_PUBLIC_GIT_COMMIT_SHA=
# Application URL for invitation links and other absolute URLs
# If not set, will be automatically detected from request headers
# NEXT_PUBLIC_APP_URL=https://your-domain.com
