# Environment Configuration for Kanvaro
# Copy this file to .env and update the values for your deployment

# ===========================================
# Database Configuration
# ===========================================
# Database credentials are configured through the setup wizard UI
# No database credentials needed in environment variables

# ===========================================
# Authentication Secrets
# ===========================================
# Generate secure random strings for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-in-production

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ===========================================
# Redis Configuration
# ===========================================
# For Docker deployment, use internal service name
REDIS_URL=redis://redis:6379

# ===========================================
# Public (client-exposed) Configuration
# ===========================================
# Exposed to the browser; safe for non-secrets
NEXT_PUBLIC_APP_VERSION=0.0.1
# Optionally set by CI to display commit SHA when version not provided
NEXT_PUBLIC_GIT_COMMIT_SHA=
# Application URL for invitation links and other absolute URLs
# If not set, will be automatically detected from request headers
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ===========================================
# Background Jobs
# ===========================================
# Self-hosted deployments need nothing here: an in-process scheduler runs the
# stand-up jobs automatically. Both variables below are optional.
#
# Set to false on serverless platforms (e.g. Vercel), where there is no
# long-lived process to run the ticker and platform crons drive the jobs instead.
# KANVARO_INTERNAL_SCHEDULER=false
#
# When set, /api/cron/* requires `Authorization: Bearer <value>`. Leave unset to
# keep the current behaviour. Vercel attaches this header to cron invocations
# automatically once the variable exists.
# CRON_SECRET=
